diff --git a/bin/fm-teardown.sh b/bin/fm-teardown.sh
--- a/bin/fm-teardown.sh
+++ b/bin/fm-teardown.sh
@@ -433,6 +433,11 @@
 if fm_task_group_present "$FM_HOME" "$ID" "$STATE"; then TEARDOWN_TASK_GROUP_BOUND=1; fi
 TEARDOWN_TASK_GROUP_COMPONENT=${FM_TASK_GROUP_COMPONENT:-false}
 TEARDOWN_TASK_GROUP_ROOT=${FM_TASK_GROUP_ROOT:-}
+TEARDOWN_TASK_GROUP_LOCAL_DELIVERY=0
+if [ "$TEARDOWN_TASK_GROUP_COMPONENT" = false ] \
+   && grep -q '^task_group_delivery=ship-local-only$' "$META"; then
+  TEARDOWN_TASK_GROUP_LOCAL_DELIVERY=1
+fi
 if [ "$TEARDOWN_TASK_GROUP_COMPONENT" = true ]; then
   # waiting verified the gathered result's identity and report digest. Keep its
   # parent-owned report as the backlog link after either task record is retired.
@@ -3353,7 +3358,11 @@
   branch=$(git -C "$WT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)
   if [ "$branch" != "HEAD" ]; then
     if git -C "$WT" checkout --detach -q 2>/dev/null; then
-      git -C "$WT" branch -D "$branch" >/dev/null 2>&1 || true
+      # Keep selected root delivery reachable through failed slot returns and
+      # endpoint/record cleanup, including homes without a backlog-close marker.
+      if [ "$TEARDOWN_TASK_GROUP_LOCAL_DELIVERY" != 1 ]; then
+        git -C "$WT" branch -D "$branch" >/dev/null 2>&1 || true
+      fi
     fi
   fi
   # Remove our hook file so a reused pool worktree cannot fire signals for a dead task.
@@ -3527,6 +3536,12 @@
     exit 1
   fi
 fi
+if [ "$TEARDOWN_TASK_GROUP_LOCAL_DELIVERY" = 1 ]; then
+  # The ordinary delivery guard proved this exact branch landed before cleanup.
+  # Best-effort ref retirement follows successful task-record removal; a crash
+  # can leave a harmless landed ref, never erase the evidence a retry needs.
+  git -C "$PROJ" branch -d "fm/$ID" >/dev/null 2>&1 || true
+fi
 fm_lock_release "$META_LOCK"
 META_LOCK_HELD=0
 if [ "$KIND" != scout ] && [ "$KIND" != secondmate ] && [ "$MODE" != local-only ]; then
