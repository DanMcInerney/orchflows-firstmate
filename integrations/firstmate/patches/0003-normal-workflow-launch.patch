diff --git a/bin/fm-spawn.sh b/bin/fm-spawn.sh
index ab16dd5..94c1c92
--- a/bin/fm-spawn.sh
+++ b/bin/fm-spawn.sh
@@ -2355,6 +2355,11 @@ fi
 # Task-group attachment is a FirstMate-owned input, validated inside this
 # launch transaction before any endpoint exists. Ordinary tasks do not load
 # the experimental controller or require its Python dependencies.
+# Resolve enabled project defaults inside the existing spawn transaction.
+if [ -e "$FM_HOME/config/orchflows.json" ] || [ -L "$FM_HOME/config/orchflows.json" ]; then
+  fm_task_group_python "$SCRIPT_DIR/fm-task-group.py" --home "$FM_HOME" auto-attach "$ID" \
+    --kind "$KIND" --backend "$BACKEND" --harness "$HARNESS" --project "$PROJ_ABS" >/dev/null || exit 1
+fi
 TASK_GROUP_BOUND=0
 TASK_GROUP_META=
 if [ -e "$FM_HOME/data/$ID/task-group/attachment.json" ] \
@@ -4131,6 +4136,14 @@ esac
 # Forward firstmate's own resolved store onto the claude launch so the crewmate
 # uses the same credential/config firstmate is authenticated with. Only when set;
 # an unset value is the single-store default and needs no prefix.
+# Pin workflow authority to this launch; clear inherited parent context for
+# components and ordinary workers. Keep the literal inside env-filtered launch.
+ORCHFLOWS_CONTEXT=
+if [ "$TASK_GROUP_BOUND" = 1 ]; then
+  ORCHFLOWS_CONTEXT=$(fm_task_group_python "$SCRIPT_DIR/fm-task-group.py" --home "$FM_HOME" \
+    launch-context "$ID" --generation "$SPAWN_GEN") || exit 1
+fi
+LAUNCH="ORCHFLOWS_FIRSTMATE_CONTEXT=$(shell_quote "$ORCHFLOWS_CONTEXT") $LAUNCH"
 if [ "$HARNESS" = claude ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
   LAUNCH="CLAUDE_CONFIG_DIR=$(shell_quote "$CLAUDE_CONFIG_DIR") $LAUNCH"
 fi
